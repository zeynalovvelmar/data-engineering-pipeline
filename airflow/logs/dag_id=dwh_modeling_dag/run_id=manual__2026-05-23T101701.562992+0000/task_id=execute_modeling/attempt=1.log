    is_active = EXCLUDED.is_active;
-- DIM_PRODUCT
INSERT INTO dwh.dim_product (
        product_id,
        product_name,
        category,
        brand,
        price,
        cost,
        is_active,
        is_current,
        effective_from,
        effective_to
    )
SELECT product_id,
    product_name,
    category,
    brand,
    price,
    cost,
    is_active,
    TRUE,
    CURRENT_DATE,
    '9999-12-31'
FROM staging.stg_products ON CONFLICT (product_id) DO
UPDATE
SET price = EXCLUDED.price,
    cost = EXCLUDED.cost,
    is_active = EXCLUDED.is_active;
-- DIM_CUSTOMER 
INSERT INTO dwh.dim_customer (
        customer_id,
        first_name,
        last_name,
        email,
        city,
        country,
        birth_date,
        age_group,
        gender,
        is_current
    )
SELECT customer_id,
    first_name,
    last_name,
    email,
    city,
    country,
    birth_date,
    CASE
        WHEN birth_date > CURRENT_DATE - INTERVAL '25 years' THEN '18-25'
        WHEN birth_date > CURRENT_DATE - INTERVAL '35 years' THEN '26-35'
        ELSE '36+'
    END,
    gender,
    TRUE
FROM staging.stg_customers ON CONFLICT (customer_id) DO
UPDATE
SET email = EXCLUDED.email,
    age_group = EXCLUDED.age_group;
-- FACT_SALES
INSERT INTO dwh.fact_sales (
        date_key,
        customer_key,
        product_key,
        store_key,
        order_id,
        item_id,
        quantity,
        unit_price,
        discount,
        gross_amount,
        net_amount,
        profit_amount,
        order_status
    )
SELECT TO_CHAR(o.order_date, 'YYYYMMDD')::INT,
    dc.customer_key,
    dp.product_key,
    ds.store_key,
    o.order_id,
    oi.item_id,
    oi.quantity,
    oi.unit_price,
    oi.discount,
    (oi.quantity * oi.unit_price),
    (oi.quantity * oi.unit_price) - oi.discount,
    ((oi.quantity * oi.unit_price) - oi.discount) - (oi.quantity * dp.cost),
    o.status
FROM staging.stg_orders o
    JOIN staging.stg_order_items oi ON o.order_id = oi.order_id
    JOIN dwh.dim_customer dc ON o.customer_id = dc.customer_id
    JOIN dwh.dim_product dp ON oi.product_id = dp.product_id
    JOIN dwh.dim_store ds ON o.store_id = ds.store_id
WHERE NOT EXISTS (
        SELECT 1
        FROM dwh.fact_sales fs
        WHERE fs.item_id = oi.item_id
    );
